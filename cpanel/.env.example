# Copy to the app root as ".env" on cPanel (or set these in
# cPanel → Setup Node.js App → Environment variables).

# Backend (server side)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser side (baked in at build time — must exist when running build:cpanel)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# App services
# --- چت هوش مصنوعی ---
# دقیقاً همان مقادیری که در Cloudflare Worker → Settings → Variables and secrets هست
# را اینجا هم قرار دهید (فقط ارائه‌دهنده‌ای که در پنل مدیریت انتخاب کرده‌اید لازم است).
LOVABLE_API_KEY=
# اگر ارائه‌دهنده Cloudflare Workers AI است:
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# سایر ارائه‌دهنده‌ها (در صورت استفاده):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

DASHBOARD_PASSWORD=
SESSION_SECRET=
# GITHUB_API_KEY=

# Server
NODE_ENV=production
# PORT is injected by Passenger; keep unset.
