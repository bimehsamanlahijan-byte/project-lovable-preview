# Copy to the app root as ".env" on cPanel (or set these in
# cPanel → Setup Node.js App → Environment variables).

# Backend (server side)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser side (baked in at build time — must exist when running build:cpanel)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# App services
LOVABLE_API_KEY=
DASHBOARD_PASSWORD=
SESSION_SECRET=
# GITHUB_API_KEY=

# Server
NODE_ENV=production
# PORT is injected by Passenger; keep unset.
